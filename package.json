{
  "name": "@caipe/agentic-apps",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "CAIPE embedded agentic application runtimes.",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs && node scripts/check-agentic-app-contract.mjs && node scripts/check-app-image-manifest.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node --test $(find ui/apps -type d \\( -name node_modules -o -name .next \\) -prune -o -type f -name '*.test.mjs' -print)"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  }
}
