# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS dependencies
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:22-alpine AS runtime
WORKDIR /app

ARG APP_ID
ARG APP_PORT
ENV NODE_ENV=production
ENV APP_ID=${APP_ID}

RUN apk upgrade --no-cache \
  && addgroup --system --gid 1001 appgroup \
  && adduser --system --uid 1001 --ingroup appgroup appuser

COPY --from=dependencies --chown=appuser:appgroup /app/node_modules ./node_modules
COPY --chown=appuser:appgroup package.json ./package.json
COPY --chown=appuser:appgroup ui/apps/_lib ./apps/_lib
COPY --chown=appuser:appgroup ui/apps/agentic-apps/${APP_ID} ./apps/agentic-apps/${APP_ID}

USER appuser

EXPOSE ${APP_PORT}
CMD ["sh", "-c", "exec node apps/agentic-apps/${APP_ID}/server.mjs"]
