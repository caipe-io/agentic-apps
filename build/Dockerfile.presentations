# syntax=docker/dockerfile:1.7
FROM node:24.22.1-alpine3.24
ARG APP_BUILD_VERSION=unknown
ARG APP_BUILD_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/caipe-io/agentic-apps"
ENV APP_BUILD_VERSION=${APP_BUILD_VERSION} APP_BUILD_REVISION=${APP_BUILD_REVISION}
WORKDIR /app
ENV NODE_ENV=production
COPY ui/apps/agentic-apps/presentations/package.json ui/apps/agentic-apps/presentations/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && addgroup -S -g 1001 app && adduser -S -u 1001 -G app app
COPY --chown=app:app ui/apps/agentic-apps/presentations/src ./src
COPY --chown=app:app ui/apps/agentic-apps/presentations/server.mjs ./server.mjs
USER app
EXPOSE 8088
CMD ["node", "server.mjs"]
