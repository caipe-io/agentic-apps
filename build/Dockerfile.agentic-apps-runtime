# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS dependencies
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production

RUN apk upgrade --no-cache \
  && addgroup --system --gid 1001 appgroup \
  && adduser --system --uid 1001 --ingroup appgroup appuser

COPY --from=dependencies --chown=appuser:appgroup /app/node_modules ./node_modules
COPY --chown=appuser:appgroup package.json ./package.json
COPY --chown=appuser:appgroup ui/apps ./apps

USER appuser

# Ports are selected by the deployment command for each application.
EXPOSE 3010 3020 3030 3040 3041 3042 3043

CMD ["node", "apps/agentic-apps/weather/server.mjs"]
