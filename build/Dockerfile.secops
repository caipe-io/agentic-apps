# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS dependencies
WORKDIR /app/apps/agentic-apps/secops
COPY ui/apps/agentic-apps/secops/package.json ui/apps/agentic-apps/secops/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
FROM node:22-alpine AS runtime
ARG APP_BUILD_VERSION=unknown
ARG APP_BUILD_REVISION=unknown
ENV APP_BUILD_VERSION=${APP_BUILD_VERSION} APP_BUILD_REVISION=${APP_BUILD_REVISION}
WORKDIR /app
ENV NODE_ENV=production
RUN apk upgrade --no-cache && addgroup --system --gid 1001 appgroup && adduser --system --uid 1001 --ingroup appgroup appuser
COPY --from=dependencies --chown=appuser:appgroup /app/apps/agentic-apps/secops/node_modules ./apps/agentic-apps/secops/node_modules
COPY --chown=appuser:appgroup ui/apps/_lib ./apps/_lib
COPY --chown=appuser:appgroup ui/apps/agentic-apps/secops ./apps/agentic-apps/secops
USER appuser
EXPOSE 3045
CMD ["node", "apps/agentic-apps/secops/server.mjs"]
