# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS dependencies
WORKDIR /app/apps/agentic-apps/ec2
COPY ui/apps/agentic-apps/ec2/package.json ui/apps/agentic-apps/ec2/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN apk upgrade --no-cache \
  && addgroup --system --gid 1001 appgroup \
  && adduser --system --uid 1001 --ingroup appgroup appuser
COPY --from=dependencies --chown=appuser:appgroup /app/apps/agentic-apps/ec2/node_modules ./apps/agentic-apps/ec2/node_modules
COPY --chown=appuser:appgroup ui/apps/_lib ./apps/_lib
COPY --chown=appuser:appgroup ui/apps/agentic-apps/ec2 ./apps/agentic-apps/ec2
USER appuser
EXPOSE 3043
CMD ["node", "apps/agentic-apps/ec2/server.mjs"]
